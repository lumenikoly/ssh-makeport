import { LineEdit, ScrollView, TextEdit, ComboBox, Palette } from "std-widgets.slint";

export struct ProjectItem { title: string, host: string }
export struct TaskItem {
    name: string, title: string, description: string, state: string,
    active: bool, can-run: bool, can-stop: bool, unknown: bool,
}
export struct PortItem { local: int, mapping: string, detail: string }

global Theme {
    out property <color> canvas: #f5f6fb;
    out property <color> surface: #ffffff;
    out property <color> ink: #28334b;
    out property <color> muted: #737d92;
    out property <color> accent: #6957c6;
    out property <color> line: #e6e8f0;
}

component ActionButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> primary: false;
    in property <bool> quiet: false;
    callback clicked();
    height: 36px;
    min-width: label.preferred-width + 28px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: 10px;
    background: !root.enabled ? #eff0f5 : root.primary ? (touch.pressed ? #51419f : touch.has-hover ? #7866d6 : Theme.accent) : touch.has-hover ? #ece9f8 : root.quiet ? transparent : #f1effa;
    border-width: focus.has-focus ? 2px : 0px;
    border-color: #b2a6e5;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { focus.focus(); root.clicked(); } }
    forward-focus: focus;
    animate background { duration: 120ms; }
    label := Text {
        text: root.text;
        color: !root.enabled ? #9aa1b1 : root.primary ? white : Theme.accent;
        font-size: 13px;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (root.enabled && (event.text == " " || event.text == "\n")) { root.clicked(); return accept; }
            return reject;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { focus.focus(); root.clicked(); }
    }
}

component Status inherits Rectangle {
    in property <string> text;
    in property <int> tone: 0;
    height: 28px;
    vertical-stretch: 0;
    horizontal-stretch: 0;
    border-radius: 14px;
    background: root.tone == 1 ? #e7f5ed : root.tone == 2 ? #fcebea : root.tone == 3 ? #fff3dc : #f0f1f6;
    Text {
        text: root.text;
        font-size: 12px;
        color: root.tone == 1 ? #27754e : root.tone == 2 ? #ac4548 : root.tone == 3 ? #96671e : Theme.muted;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component Heading inherits Text {
    font-size: 15px;
    font-weight: 600;
    color: Theme.ink;
}

export component MainWindow inherits Window {
    title: "MakePort";
    init => { Palette.color-scheme = ColorScheme.light; }
    preferred-width: 880px;
    preferred-height: 660px;
    min-width: 720px;
    min-height: 540px;
    default-font-size: 14px;
    background: Theme.canvas;

    in property <[ProjectItem]> projects;
    in property <[string]> project-titles;
    in property <[TaskItem]> tasks;
    in property <[PortItem]> ports;
    in property <int> selected: -1;
    in property <string> project-name;
    in property <string> project-location;
    in property <string> connection: "Загрузка…";
    in property <bool> connected;
    in property <bool> desired;
    in property <bool> can-change;
    in property <bool> can-connect;
    in property <int> running;
    in property <string> next-action;
    in property <bool> discovering;
    in-out property <bool> show-log: false;
    in property <string> log-name;
    in property <string> log-text;
    in-out property <string> notice;
    in property <bool> fatal;
    in property <bool> quitting;
    in property <string> mono-font: "monospace";

    in-out property <bool> editing: false;
    in-out property <string> edit-id;
    in property <bool> edit-is-new;
    in-out property <string> edit-name;
    in-out property <string> edit-host;
    in-out property <string> edit-error;
    in-out property <string> edit-path;
    in-out property <string> edit-ports;
    in-out property <string> edit-tasks;
    in-out property <bool> edit-reconnect: true;
    in-out property <string> confirm-kind;
    in-out property <string> confirm-target;
    in-out property <bool> follow-log: true;
    private property <bool> interactive: !root.editing && !root.show-log && root.confirm-kind == "" && !root.quitting;

    callback select-project(int);
    callback new-project();
    callback edit-project();
    callback save-project(bool);
    callback delete-project();
    callback toggle-connection();
    callback refresh-tasks();
    callback run-target(string);
    callback stop-target(string);
    callback reset-target(string);
    callback select-log(string);
    callback clear-log();
    callback open-port(int);
    callback open-config();
    callback dismiss-notice();
    callback quit();
    callback scroll-log();

    scroll-log => { }
    VerticalLayout {
        padding: 24px;
        spacing: 16px;
        HorizontalLayout {
            spacing: 10px;
            Rectangle {
                width: 36px; height: 36px; vertical-stretch: 0;
                border-radius: 11px; background: Theme.accent;
                Text { text: "m"; color: white; font-size: 27px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
            }
            Heading { text: "MakePort"; font-size: 22px; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
            if root.projects.length > 1: chooser := ComboBox {
                model: root.project-titles;
                current-index: root.selected;
                enabled: root.can-change && root.interactive;
                selected(index) => { root.select-project(chooser.current-index); }
            }
            if root.selected >= 0: ActionButton { text: "Открыть папку…"; enabled: root.can-change && root.interactive; clicked => { root.new-project(); } }
        }
        if root.selected >= 0: HorizontalLayout {
            spacing: 8px;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 5px;
                Heading { text: root.project-name; font-size: 24px; }
                Text { text: root.project-location; overflow: elide; color: Theme.muted; }
                HorizontalLayout {
                    Status { width: 152px; text: root.connection; tone: root.connected ? 1 : root.connection == "Ошибка подключения" ? 2 : root.desired ? 3 : 0; }
                    Rectangle { horizontal-stretch: 1; }
                }
            }
            ActionButton { quiet: true; width: 100px; horizontal-stretch: 0; text: "Изменить"; enabled: root.can-change && root.interactive; clicked => { root.edit-project(); } }
            ActionButton {
                width: 140px; horizontal-stretch: 0;
                text: root.desired ? "Отключиться" : "Подключиться";
                primary: !root.desired;
                enabled: root.can-connect && root.interactive;
                clicked => { if root.running > 0 { root.confirm-kind = "disconnect"; } else { root.toggle-connection(); } }
            }
        }
        if root.notice != "": Rectangle {
            background: Theme.surface;
            border-radius: 14px;
                    border-width: 1px; border-color: Theme.line;
            min-height: 64px;
            HorizontalLayout {
                padding: 12px;
                Text { text: root.notice; wrap: word-wrap; horizontal-stretch: 1; }
                ActionButton { text: "Журнал"; clicked => { root.select-log(""); root.show-log = true; } }
                ActionButton { text: "×"; clicked => { root.dismiss-notice(); } }
            }
        }
        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 12px;
                if root.selected < 0: VerticalLayout {
                    padding-top: 48px;
                    spacing: 14px;
                    Heading { text: "Откройте проект на сервере"; font-size: 22px; }
                    Text { text: "Укажите SSH-адрес и папку. Порты и действия загрузятся из makeport.toml."; wrap: word-wrap; color: Theme.muted; }
                    ActionButton { text: "Открыть папку…"; width: 190px; primary: true; enabled: root.can-change && root.interactive; clicked => { root.new-project(); } }
                }
                if root.ports.length > 0: Heading { text: "Порты"; height: 24px; font-size: 13px; color: Theme.muted; }
                for port in root.ports: Rectangle {
                    height: 64px;
                    background: Theme.surface;
                    border-radius: 14px;
                    border-width: 1px; border-color: Theme.line;
                    HorizontalLayout {
                        padding: 12px;
                        spacing: 12px;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 5px;
                            Heading { text: port.detail; overflow: elide; }
                            Text { text: port.mapping; font-size: 12px; color: Theme.muted; }
                        }
                        Status { width: 140px; text: root.connected ? "Проброшен" : root.connection == "Ошибка подключения" ? "Ошибка" : root.desired ? "Подключается…" : "Не подключён"; tone: root.connected ? 1 : root.connection == "Ошибка подключения" ? 2 : root.desired ? 3 : 0; }
                        ActionButton { width: 110px; horizontal-stretch: 0; text: "Открыть"; enabled: root.connected && root.interactive; clicked => { root.open-port(port.local); } }
                    }
                }
                if root.tasks.length > 0: Heading { text: "Действия"; height: 24px; font-size: 13px; color: Theme.muted; }
                for task in root.tasks: Rectangle {
                    height: 74px;
                    background: Theme.surface;
                    border-radius: 14px;
                    border-width: 1px; border-color: Theme.line;
                    HorizontalLayout {
                        padding: 12px;
                        spacing: 12px;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 5px;
                            Heading { text: task.title; overflow: elide; }
                            Text { text: "make " + task.name; font-size: 12px; color: Theme.muted; }
                        }
                        Status { width: 140px; text: task.state; tone: task.unknown ? 3 : task.active || task.state == "Готово" ? 1 : task.state == "Готова" || task.state == "Остановлена" ? 0 : 2; }
                        ActionButton { quiet: true; width: 80px; horizontal-stretch: 0; text: "Журнал"; enabled: root.interactive; clicked => { root.select-log(task.name); root.show-log = true; } }
                        ActionButton {
                            width: 110px; horizontal-stretch: 0;
                            primary: !task.active && !task.unknown;
                            text: task.unknown ? "Проверить" : task.active ? "Остановить" : "Запустить";
                            enabled: root.interactive && (task.can-run || task.can-stop || task.unknown);
                            clicked => {
                                if task.unknown { root.confirm-target = task.name; root.confirm-kind = "reset"; }
                                else if task.active { root.stop-target(task.name); }
                                else { root.run-target(task.name); }
                            }
                        }
                    }
                }
                if root.selected >= 0 && root.ports.length == 0 && root.tasks.length == 0: Text {
                    text: root.discovering ? "Читаем настройки проекта…" : root.connected ? "Добавьте порты и действия в makeport.toml в этой папке, затем нажмите «Обновить»." : "Подключитесь, чтобы загрузить порты и действия проекта.";
                    wrap: word-wrap;
                    color: Theme.muted;
                }
                Rectangle { vertical-stretch: 1; }
            }
        }
        if root.selected >= 0: HorizontalLayout {
            Text { text: "makeport.toml · настройки в папке проекта"; font-size: 12px; color: Theme.muted; }
            Rectangle { horizontal-stretch: 1; }
            ActionButton { quiet: true; text: root.discovering ? "Читаем…" : "Обновить"; enabled: root.connected && !root.discovering && root.interactive; clicked => { root.refresh-tasks(); } }
            ActionButton { quiet: true; text: "Журнал подключения"; clicked => { root.select-log(""); root.show-log = true; } }
        }
    }
    if root.editing: Rectangle {
        background: #20263e66;
        Rectangle {
            width: min(540px, parent.width - 32px);
            height: 390px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.surface;
            border-radius: 20px;
            VerticalLayout {
                padding: 24px;
                spacing: 12px;
                Heading { text: "Открыть папку по SSH"; font-size: 22px; }
                Text { text: "SSH-адрес"; }
                LineEdit { text <=> root.edit-host; placeholder-text: "dev-server или user@server"; }
                Text { text: "Папка на сервере"; }
                LineEdit { text <=> root.edit-path; placeholder-text: "~/projects/site"; }
                Text { text: "Используем локальные SSH-настройки и ключи. Порты и действия прочитаем из makeport.toml."; wrap: word-wrap; color: Theme.muted; }
                Text { text: root.edit-error; wrap: word-wrap; color: #b23b35; }
                HorizontalLayout {
                    spacing: 8px;
                    if !root.edit-is-new: ActionButton { text: "Удалить"; clicked => { root.confirm-kind = "delete"; root.editing = false; } }
                    Rectangle { horizontal-stretch: 1; }
                    ActionButton { text: "Отмена"; clicked => { root.editing = false; } }
                    ActionButton { text: "Открыть"; primary: true; clicked => { root.save-project(true); } }
                }
            }
        }
    }
    if root.show-log: Rectangle {
        background: #20263e66;
        Rectangle {
            x: 24px; y: 24px;
            width: parent.width - 48px; height: parent.height - 48px;
            background: Theme.surface;
            border-radius: 18px;
            VerticalLayout {
                padding: 20px;
                spacing: 12px;
                HorizontalLayout {
                    Heading { text: root.log-name == "" ? "Журнал подключения" : "make " + root.log-name; }
                    ActionButton { text: "Закрыть"; clicked => { root.show-log = false; } }
                }
                TextEdit { text: root.log-text; read-only: true; font-family: root.mono-font; vertical-stretch: 1; }
            }
        }
    }
    if root.confirm-kind != "": Rectangle {
        background: #20263e66;
        Rectangle {
            width: min(520px, parent.width - 32px); height: 240px;
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            background: Theme.surface; border-radius: 18px;
            VerticalLayout {
                padding: 24px; spacing: 16px;
                Heading { text: root.confirm-kind == "reset" ? "Задача уже завершена?" : root.confirm-kind == "delete" ? "Удалить сохранённую папку?" : "Остановить задачи?"; font-size: 20px; }
                Text { text: root.confirm-kind == "reset" ? "Проверьте процесс на сервере. Подтвердите только если задача завершена — это разрешит повторный запуск." : root.confirm-kind == "delete" ? "Папка и файлы на сервере сохранятся." : "Активные задачи будут остановлены, подключение закроется."; wrap: word-wrap; }
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle { horizontal-stretch: 1; }
                    ActionButton { text: "Отмена"; clicked => { root.confirm-kind = ""; } }
                    ActionButton { text: "Подтвердить"; primary: true; clicked => {
                        if root.confirm-kind == "reset" { root.reset-target(root.confirm-target); }
                        else if root.confirm-kind == "delete" { root.delete-project(); }
                        else if root.confirm-kind == "quit" { root.quit(); }
                        else { root.toggle-connection(); }
                        root.confirm-kind = "";
                    } }
                }
            }
        }
    }
    if root.quitting: Rectangle { background: Theme.canvas; Text { text: "Закрываем подключение…"; horizontal-alignment: center; vertical-alignment: center; } }
}
