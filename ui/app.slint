import { ScrollView, TextEdit, Palette } from "std-widgets.slint";

export struct ProjectItem { title: string, host: string, location: string, state: string }
export struct TaskItem {
    name: string, title: string, description: string, state: string,
    active: bool, can-run: bool, can-stop: bool, unknown: bool,
}
export struct PortItem { local: int, remote: int, mapping: string, detail: string, state: string, can-open: bool }

global Theme {
    out property <color> canvas: #f7f9f9;
    out property <color> surface: #ffffff;
    out property <color> ink: #18343c;
    out property <color> muted: #62777f;
    out property <color> accent: #147d70;
    out property <color> line: #e5ebec;
    out property <color> sidebar: #152e36;
}

component ActionButton inherits Rectangle {
    in property <string> text;
    in property <string> accessible-name: root.text;
    in property <image> icon;
    in property <bool> enabled: true;
    in property <bool> primary: false;
    in property <bool> quiet: false;
    in property <bool> danger: false;
    callback clicked();
    height: 38px;
    min-width: label.preferred-width + (root.icon.width > 0 ? 42px : 26px);
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: 8px;
    border-width: focus.has-focus ? 2px : root.primary || root.quiet ? 0px : 1px;
    border-color: focus.has-focus ? #52b3a6 : Theme.line;
    background: !root.enabled ? #edf1f2 : root.primary ? (touch.pressed ? #105f56 : touch.has-hover ? #118d7d : Theme.accent) : touch.has-hover ? (root.danger ? #fff0ee : #edf5f3) : root.quiet ? transparent : white;
    accessible-role: button;
    accessible-label: root.accessible-name;
    accessible-enabled: root.enabled;
    Tooltip {
        Rectangle { background: Theme.sidebar; border-radius: 5px;
            HorizontalLayout { padding: 8px; Text { text: root.accessible-name; color: white; font-size: 12px; } }
        }
    }
    accessible-action-default => { if root.enabled { focus.focus(); root.clicked(); } }
    forward-focus: focus;
    animate background { duration: 100ms; }
    HorizontalLayout {
        padding-left: 12px; padding-right: 12px; spacing: 7px;
        if root.icon.width > 0: VerticalLayout {
            width: 16px; horizontal-stretch: 0; alignment: center;
            Image {
                source: root.icon; width: 16px; height: 16px;
                vertical-stretch: 0; horizontal-stretch: 0;
                colorize: !root.enabled ? #a2afb3 : root.primary ? white : root.danger ? #bc514c : Theme.ink;
            }
        }
        label := Text {
            text: root.text;
            color: !root.enabled ? #a2afb3 : root.primary ? white : root.danger ? #bc514c : Theme.ink;
            font-size: 13px; font-weight: 500;
            horizontal-alignment: center; vertical-alignment: center;
        }
    }
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if root.enabled && (event.text == " " || event.text == "\n") { root.clicked(); return accept; }
            return reject;
        }
    }
    touch := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { focus.focus(); root.clicked(); } }
}

component Status inherits Rectangle {
    in property <string> text;
    in property <int> tone;
    horizontal-stretch: 0; vertical-stretch: 0; height: 26px;
    min-width: status-text.preferred-width + 30px;
    border-radius: 5px;
    background: root.tone == 1 ? #eaf6f0 : root.tone == 2 ? #fceeed : root.tone == 3 ? #fff5e3 : #f1f4f5;
    HorizontalLayout {
        padding-left: 9px; padding-right: 9px; spacing: 6px;
        VerticalLayout {
            width: 6px; horizontal-stretch: 0; alignment: center;
            Rectangle {
                width: 6px; height: 6px; border-radius: 3px; horizontal-stretch: 0; vertical-stretch: 0;
                background: root.tone == 1 ? #3c9a72 : root.tone == 2 ? #c5665c : root.tone == 3 ? #b99041 : #9ba9ae;
            }
        }
        status-text := Text {
            text: root.text; font-size: 11px;
            color: root.tone == 1 ? #347459 : root.tone == 2 ? #aa4d46 : root.tone == 3 ? #946e2d : Theme.muted;
            vertical-alignment: center;
        }
    }
}
component Heading inherits Text { font-size: 16px; font-weight: 600; color: Theme.ink; }

// Native editing and clipboard, including shortcuts in the Russian keyboard layout.
component Field inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <string> label;
    in property <bool> enabled: true;
    callback accepted();
    height: 44px; min-width: 80px; vertical-stretch: 0;
    background: input.has-focus ? white : #fbfcfc;
    border-radius: 8px; border-width: input.has-focus ? 2px : 1px;
    border-color: input.has-focus ? #6db6ab : #dce4e6;
    clip: true;
    forward-focus: input;
    public function focus-field() { input.focus(); }
    Text {
        x: 12px; width: parent.width - 24px; height: 100%; text: root.text == "" ? root.placeholder : "";
        color: #9ba8ad; font-size: 14px; vertical-alignment: center;
        accessible-role: none;
    }
    ContextMenuArea {
        enabled: root.enabled;
        x: 12px; width: parent.width - 24px; height: 100%;
        Menu {
            MenuItem { title: "Вырезать"; enabled: root.text != ""; activated => { input.cut(); } }
            MenuItem { title: "Копировать"; enabled: root.text != ""; activated => { input.copy(); } }
            MenuItem { title: "Вставить"; activated => { input.paste(); } }
            MenuItem { title: "Выделить всё"; enabled: root.text != ""; activated => { input.select-all(); } }
        }
        input := TextInput {
            private property <length> offset;
            x: min(0px, max(parent.width - self.width - self.text-cursor-width, self.offset));
            width: max(parent.width - self.text-cursor-width, self.preferred-width); height: 100%;
            single-line: true; text <=> root.text; color: Theme.ink; font-size: 14px; vertical-alignment: center;
            enabled: root.enabled;
            selection-background-color: #c5e8df; selection-foreground-color: Theme.ink;
            accessible-label: root.label; accessible-placeholder-text: root.placeholder;
            cursor-position-changed(position) => {
                if position.x + self.offset < 0px { self.offset = -position.x; }
                else if position.x + self.offset > parent.width - self.text-cursor-width { self.offset = parent.width - position.x - self.text-cursor-width; }
            }
            accepted => { root.accepted(); }
            key-pressed(event) => {
                if event.modifiers.control && !event.modifiers.alt {
                    if event.text == "c" || event.text == "C" || event.text == "с" || event.text == "С" { self.copy(); return accept; }
                    if event.text == "v" || event.text == "V" || event.text == "м" || event.text == "М" { self.paste(); return accept; }
                    if event.text == "x" || event.text == "X" || event.text == "ч" || event.text == "Ч" { self.cut(); return accept; }
                    if event.text == "a" || event.text == "A" || event.text == "ф" || event.text == "Ф" { self.select-all(); return accept; }
                    if event.text == Key.Insert { self.copy(); return accept; }
                }
                if event.modifiers.shift && event.text == Key.Insert { self.paste(); return accept; }
                if event.modifiers.shift && event.text == Key.Delete { self.cut(); return accept; }
                return reject;
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "MakePort";
    icon: @image-url("../assets/makeport.png");
    init => { Palette.color-scheme = ColorScheme.light; }
    preferred-width: 1020px; preferred-height: 740px;
    min-width: 720px; min-height: 540px;
    default-font-size: 14px; background: Theme.canvas;

    in property <[ProjectItem]> projects;
    in property <[TaskItem]> tasks;
    in property <[PortItem]> ports;
    in property <int> selected: -1;
    in property <string> project-name;
    in property <string> project-location;
    in property <string> connection: "Загрузка…";
    in property <bool> connected;
    in property <bool> desired;
    in property <bool> can-change;
    in property <bool> can-add;
    in property <bool> can-reload;
    in property <bool> can-manage-ports;
    in property <int> total-running;
    in property <bool> can-connect;
    in property <int> running;
    in property <string> next-action;
    in-out property <bool> show-log: false;
    in property <string> log-name;
    in property <string> log-text;
    in-out property <string> notice;
    in property <bool> fatal;
    in property <bool> quitting;
    in property <bool> can-hide-to-tray;
    in property <string> mono-font: "monospace";

    in-out property <bool> editing: false;
    in-out property <string> edit-id;
    in property <bool> edit-is-new;
    in-out property <string> edit-name;
    in-out property <string> edit-host;
    in-out property <[string]> ssh-hosts;
    in-out property <bool> ssh-loading: false;
    in-out property <string> ssh-config-message;
    in-out property <string> edit-error;
    in-out property <string> edit-path;
    in-out property <string> edit-ports;
    in-out property <string> edit-tasks;
    in-out property <bool> edit-reconnect: true;
    in-out property <string> confirm-kind;
    in-out property <string> confirm-target;
    in-out property <bool> follow-log: true;
    in-out property <bool> settings-open: false;
    in-out property <bool> edit-advanced: false;
    in-out property <bool> show-tasks: false;
    in-out property <string> port-input;
    in-out property <string> port-error;
    callback add-ports(string);
    callback remove-port(int);
    private property <bool> interactive: !root.editing && !root.settings-open && !root.show-log && root.confirm-kind == "" && !root.quitting;

    callback select-project(int);
    callback new-project();
    callback edit-project();
    callback save-project(bool);
    callback delete-project();
    callback toggle-connection();
    callback refresh-tasks();
    callback run-target(string);
    callback stop-target(string);
    callback reset-target(string);
    callback select-log(string);
    callback clear-log();
    callback open-port(int);
    callback open-config();
    callback dismiss-notice();
    callback quit();
    callback hide-to-tray();
    callback request-quit();
    callback scroll-log();

    public function focus-editor() { host-field.focus-field(); }
    public function show-ssh-hosts() { ssh-picker.show(); }
    public function use-ssh-host(host: string) {
        root.edit-host = host;
        ssh-picker.close();
        ports-field.focus-field();
    }
    changed confirm-kind => { if root.confirm-kind != "" { confirm-cancel.focus(); } }
    changed show-log => { if root.show-log { root.follow-log = true; root.scroll-log(); } }
    private property <string> copy-message;
    public function copy-value(value: string) { clipboard-proxy.text = value; clipboard-proxy.select-all(); clipboard-proxy.copy(); root.copy-message = "Скопировано"; }
    Timer { interval: 1800ms; running: root.copy-message != ""; triggered => { root.copy-message = ""; } }
    clipboard-proxy := TextInput { visible: false; }
    scroll-log => { if root.follow-log { log-editor.viewport-y = min(0px, log-editor.visible-height - log-editor.viewport-height); } }

    FocusScope {
        forward-focus: new-project-button;
        key-pressed(event) => {
            if event.text == Key.Escape {
                if root.confirm-kind != "" { root.confirm-kind = ""; }
                else if root.editing { root.editing = false; }
                else if root.settings-open { root.settings-open = false; }
                else if root.show-log { root.show-log = false; }
                return accept;
            }
            return reject;
        }
        HorizontalLayout {
            spacing: 0px;
            Rectangle {
                width: 184px; horizontal-stretch: 0;
                background: Theme.sidebar;
                VerticalLayout {
                    padding: 16px; padding-top: 26px; spacing: 14px;
                    HorizontalLayout {
                        spacing: 10px;
                        Rectangle {
                            width: 28px; height: 28px; border-radius: 8px; background: #a7e1d2;
                            horizontal-stretch: 0; vertical-stretch: 0;
                            Image { x: 6px; y: 6px; width: 16px; height: 16px; source: @image-url("icons/link.svg"); colorize: Theme.sidebar; }
                        }
                        Text { text: "MakePort"; color: white; font-size: 19px; font-weight: 600; vertical-alignment: center; }
                    }
                    Text { text: "ПОДКЛЮЧЕНИЯ"; color: #7d9ca5; font-size: 10px; letter-spacing: 1px; height: 18px; }
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 6px;
                            for project[index] in root.projects: Rectangle {
                                height: 78px; border-radius: 9px;
                                background: root.selected == index ? #27464e : project-touch.has-hover ? #1c3a43 : transparent;
                                border-width: project-focus.has-focus ? 1px : 0px; border-color: #74c0ad;
                                accessible-role: button; accessible-label: project.title + ", " + project.location + ", " + project.state;
                                Tooltip {
                                    Rectangle { background: Theme.sidebar; border-radius: 5px;
                                        VerticalLayout { padding: 10px; spacing: 4px;
                                            Text { text: project.location; color: white; font-size: 12px; }
                                            Text { text: project.state; color: #a7e1d2; font-size: 11px; }
                                        }
                                    }
                                }
                                accessible-enabled: root.can-add && root.interactive;
                                accessible-action-default => { if root.can-add && root.interactive { root.select-project(index); } }
                                forward-focus: project-focus;
                                VerticalLayout {
                                    padding: 12px; spacing: 4px;
                                    Text { text: project.title; color: #eff8f7; font-weight: 600; overflow: elide; }
                                    Text { text: project.host; color: #9db5bd; font-size: 11px; overflow: elide; }
                                    Text { text: project.state; color: project.state == "Не подключён" ? #7996a0 : #9fdbca; font-size: 10px; overflow: elide; }
                                }
                                project-focus := FocusScope {
                                    enabled: root.can-add && root.interactive;
                                    key-pressed(event) => { if event.text == "\n" || event.text == " " { root.select-project(index); return accept; } return reject; }
                                }
                                project-touch := TouchArea { enabled: root.can-add && root.interactive; mouse-cursor: pointer; clicked => { project-focus.focus(); root.select-project(index); } }
                            }
                            Rectangle { vertical-stretch: 1; }
                        }
                    }
                    new-project-button := ActionButton {
                        text: "Добавить"; icon: @image-url("icons/plus.svg");
                        accessible-name: "Добавить подключение";
                        enabled: root.can-add && root.interactive;
                        clicked => { root.new-project(); }
                    }
                    ActionButton {
                        text: "Настройки"; icon: @image-url("icons/settings.svg");
                        enabled: root.interactive; clicked => { root.settings-open = true; }
                    }
                }
            }
            Rectangle {
                VerticalLayout {
                    padding: 24px; spacing: 16px;
                    if root.selected < 0: VerticalLayout {
                        padding: 22px; spacing: 16px;
                        Rectangle { vertical-stretch: 1; }
                        Rectangle {
                            width: 72px; height: 72px; border-radius: 22px; background: #e4f1ed;
                            horizontal-stretch: 0; vertical-stretch: 0;
                            Image { x: 20px; y: 20px; width: 32px; height: 32px; source: @image-url("icons/server.svg"); colorize: Theme.accent; }
                        }
                        Heading { text: "Ваши порты.\nНа любом сервере."; font-size: 32px; }
                        Text { text: "Укажите сервер и порты.\nMakePort подключит их к этому компьютеру."; color: Theme.muted; font-size: 15px; wrap: word-wrap; }
                        ActionButton { text: "Добавить подключение"; primary: true; icon: @image-url("icons/plus.svg"); enabled: root.can-add && root.interactive; clicked => { root.new-project(); } }
                        Rectangle { vertical-stretch: 1; }
                    }
                    if root.selected >= 0: VerticalLayout {
                        spacing: 12px;
                        HorizontalLayout {
                            spacing: 10px;
                            Heading { text: root.project-name; font-size: 28px; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
                            ActionButton { text: "Изменить"; accessible-name: root.can-change ? "Изменить подключение" : "Отключите соединение, чтобы изменить сервер и список портов"; quiet: true; enabled: root.can-change && root.interactive; clicked => { root.edit-project(); } }
                            ActionButton {
                                text: root.desired ? (root.connected ? "Отключить" : "Отменить") : root.connection == "Ошибка подключения" ? "Повторить" : "Подключить"; primary: !root.desired;
                                enabled: root.can-connect && root.interactive;
                                clicked => { if root.desired && root.running > 0 { root.confirm-kind = "disconnect"; } else { root.toggle-connection(); } }
                            }
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            Status { text: root.connection; tone: root.connected ? 1 : root.connection == "Ошибка подключения" ? 2 : root.desired ? 3 : 0; }
                            Rectangle { horizontal-stretch: 1; }
                        }
                    }
                    if root.notice != "": Rectangle {
                        min-height: 70px; border-radius: 9px; background: #fff5e8; border-width: 1px; border-color: #f3e6d0;
                        HorizontalLayout {
                            padding: 12px; spacing: 8px;
                            Text { text: root.notice; color: #825c33; wrap: word-wrap; font-size: 12px; horizontal-stretch: 1; }
                            ActionButton { text: "Подробнее"; quiet: true; enabled: root.interactive; clicked => { root.select-log(""); root.show-log = true; } }
                            ActionButton { icon: @image-url("icons/close.svg"); accessible-name: "Скрыть сообщение"; quiet: true; enabled: root.interactive; clicked => { root.dismiss-notice(); } }
                        }
                    }
                    if root.selected >= 0: ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 8px;
                            HorizontalLayout {
                                spacing: 10px;
                                Heading { text: "Порты"; vertical-alignment: center; }
                                Text { text: root.ports.length == 0 ? "" : root.ports.length; color: Theme.muted; font-size: 12px; vertical-alignment: center; }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                port-field := Field {
                                    text <=> root.port-input; label: "Добавить порты";
                                    placeholder: "3000, 15432:5432, 8000-8010";
                                    enabled: root.can-manage-ports && root.interactive;
                                    accepted => { root.add-ports(root.port-input); }
                                }
                                ActionButton { text: "Добавить"; enabled: root.can-manage-ports && root.interactive && root.port-input != ""; clicked => { root.add-ports(root.port-input); } }
                            }
                            if root.port-error != "": Text { text: root.port-error; color: #b2534a; wrap: word-wrap; font-size: 12px; }
                            if root.ports.length == 0: Rectangle {
                                height: 82px; background: Theme.surface; border-radius: 10px; border-width: 1px; border-color: Theme.line;
                                VerticalLayout { padding: 16px; spacing: 5px;
                                    Text { text: "Портов пока нет"; color: Theme.ink; font-weight: 500; }
                                    Text { text: "Введите порт выше. Например, 3000 или 15432:5432."; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                                }
                            }
                            for port in root.ports: Rectangle {
                                height: 64px; background: Theme.surface; border-radius: 10px; border-width: 1px; border-color: Theme.line;
                                HorizontalLayout {
                                    padding: 12px; spacing: 8px;
                                    VerticalLayout {
                                        horizontal-stretch: 1; spacing: 4px;
                                        Heading { text: port.mapping; font-size: 14px; overflow: elide; }
                                        Text { text: (port.detail == "Порт " + port.remote ? "На сервере: " : port.detail + " · на сервере: ") + port.remote; color: Theme.muted; font-size: 12px; overflow: elide; }
                                    }
                                    ActionButton { icon: @image-url("icons/copy.svg"); accessible-name: "Копировать адрес порта " + port.local; quiet: true; enabled: root.interactive; clicked => { root.copy-value("http://localhost:" + port.local); } }
                                    ActionButton {
                                        text: "Открыть";
                                        icon: @image-url("icons/external.svg");
                                        enabled: root.interactive && port.can-open;
                                        clicked => { root.open-port(port.local); }
                                    }
                                    ActionButton { icon: @image-url("icons/close.svg"); accessible-name: "Удалить порт " + port.local; quiet: true; enabled: root.can-manage-ports && root.interactive; clicked => { root.remove-port(port.local); } }
                                }
                            }
                            if root.tasks.length > 0: HorizontalLayout {
                                padding-top: 12px;
                                ActionButton {
                                    text: (root.show-tasks ? "Скрыть задачи Make" : "Задачи Make · " + root.tasks.length) + (root.running > 0 ? " · работают: " + root.running : "");
                                    quiet: true; enabled: root.interactive;
                                    clicked => { root.show-tasks = !root.show-tasks; }
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            if root.show-tasks: VerticalLayout {
                                spacing: 8px;
                                for task in root.tasks: Rectangle {
                                    height: 74px; background: Theme.surface; border-radius: 10px; border-width: 1px; border-color: Theme.line;
                                    HorizontalLayout {
                                        padding: 12px; spacing: 8px;
                                        VerticalLayout {
                                            horizontal-stretch: 1; spacing: 4px;
                                            Heading { text: task.title; font-size: 14px; overflow: elide; }
                                            HorizontalLayout {
                                                spacing: 8px;
                                                Status { text: task.state; tone: task.unknown ? 3 : task.active || task.state == "Готово" ? 1 : task.state == "Готова" || task.state == "Остановлена" ? 0 : 2; }
                                                if root.width >= 900px: Text { text: "make " + task.name; color: #94a2a7; font-size: 11px; vertical-alignment: center; }
                                                Rectangle { horizontal-stretch: 1; }
                                            }
                                        }
                                        ActionButton { icon: @image-url("icons/log.svg"); accessible-name: "Журнал задачи " + task.title; quiet: true; enabled: root.interactive; clicked => { root.select-log(task.name); root.show-log = true; } }
                                        ActionButton {
                                            text: task.unknown ? "Проверить" : task.active ? "Остановить" : "Запустить";
                                            icon: task.active ? @image-url("icons/stop.svg") : @image-url("icons/play.svg");
                                            primary: !task.active && !task.unknown; danger: task.active;
                                            enabled: root.interactive && (task.can-run || task.can-stop || task.unknown);
                                            clicked => {
                                                if task.unknown { root.confirm-target = task.name; root.confirm-kind = "reset"; }
                                                else if task.active { root.stop-target(task.name); }
                                                else { root.run-target(task.name); }
                                            }
                                        }
                                    }
                                }
                            }
                            Rectangle { vertical-stretch: 1; }
                        }
                    }
                }
            }
        }

        Rectangle {
            visible: root.editing; background: #0c263877;
            FocusScope {
                enabled: root.confirm-kind == "" && !root.quitting;
            Rectangle {
                width: min(500px, parent.width - 48px); height: min(root.edit-advanced ? 650px : 420px, parent.height - 32px);
                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                background: Theme.surface; border-radius: 16px;
                VerticalLayout {
                    padding: 28px; spacing: 12px;
                    HorizontalLayout {
                        Heading { text: root.edit-is-new ? "Новое подключение" : "Изменить подключение"; font-size: 22px; horizontal-stretch: 1; }
                        ActionButton { icon: @image-url("icons/close.svg"); accessible-name: "Закрыть настройки"; quiet: true; clicked => { root.editing = false; } }
                    }
                    ScrollView {
                        VerticalLayout { spacing: 10px;
                            Text { text: "Сервер и порты — всё, что нужно для подключения."; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                            Text { text: "Сервер"; color: Theme.ink; font-size: 12px; font-weight: 500; }
                            HorizontalLayout {
                                spacing: 8px;
                                host-field := Field {
                                    text <=> root.edit-host; label: "Сервер"; placeholder: "devbox или user@server";
                                    accepted => { ports-field.focus-field(); }
                                    ssh-picker := PopupWindow {
                                        y: parent.height + 4px; width: parent.width;
                                        height: min(260px, root.ssh-hosts.length * 38px + 16px);
                                        Rectangle {
                                            background: Theme.surface; border-width: 1px; border-color: Theme.line; border-radius: 8px; clip: true;
                                            ScrollView {
                                                x: 4px; y: 4px; width: parent.width - 8px; height: parent.height - 8px;
                                                VerticalLayout {
                                                    spacing: 2px;
                                                    for host in root.ssh-hosts: ActionButton {
                                                        text: host; min-width: 0px; quiet: true;
                                                        accessible-name: "Использовать SSH-подключение " + host;
                                                        clicked => { root.use-ssh-host(host); }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                if root.ssh-hosts.length > 0: ActionButton {
                                    text: "Из SSH"; icon: @image-url("icons/server.svg");
                                    accessible-name: "Выбрать подключение из SSH-настроек";
                                    enabled: !root.ssh-loading;
                                    clicked => { root.show-ssh-hosts(); }
                                }
                            }
                            if root.ssh-loading: Text { text: "Читаем SSH-настройки…"; color: Theme.muted; font-size: 12px; }
                            if root.ssh-config-message != "": Text { text: root.ssh-config-message; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                            Text { text: "Порты"; color: Theme.ink; font-size: 12px; font-weight: 500; }
                            ports-field := Field { text <=> root.edit-ports; label: "Порты"; placeholder: "3000, 15432:5432, 8000-8010"; accepted => { root.save-project(root.edit-is-new); } }
                            Text { text: "Формат: порт или локальный:серверный. Можно списком или диапазоном."; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                            ActionButton { text: root.edit-advanced ? "Скрыть дополнительные настройки" : "Дополнительно"; quiet: true; clicked => { root.edit-advanced = !root.edit-advanced; } }
                            if root.edit-advanced: VerticalLayout {
                                spacing: 8px;
                                Text { text: "Название · необязательно"; color: Theme.muted; font-size: 12px; }
                                Field { text <=> root.edit-name; label: "Название подключения"; placeholder: "Например, сервер разработки"; }
                                Text { text: "Задачи Make · необязательно"; color: Theme.muted; font-size: 12px; }
                                Field { text <=> root.edit-tasks; label: "Задачи Make"; placeholder: "dev, test, build"; }
                                Text { text: "Папка для Make"; color: Theme.muted; font-size: 12px; }
                                Field { text <=> root.edit-path; label: "Папка для Make"; placeholder: "~"; }
                            }
                            if root.edit-error != "": Text { text: root.edit-error; color: #b2534a; font-size: 12px; wrap: word-wrap; }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        if !root.edit-is-new: ActionButton { text: "Удалить"; danger: true; quiet: true; clicked => { root.confirm-kind = "delete"; root.editing = false; } }
                        Rectangle { horizontal-stretch: 1; }
                        ActionButton { text: "Отмена"; clicked => { root.editing = false; } }
                        ActionButton { text: root.edit-is-new ? "Подключить" : "Сохранить"; primary: true; clicked => { root.save-project(root.edit-is-new); } }
                    }
                }
            }
            }
        }
        Rectangle {
            visible: root.settings-open; background: #0c263877;
            Rectangle {
                width: min(400px, parent.width - 48px); height: min(root.can-hide-to-tray ? 460px : 410px, parent.height - 32px);
                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                background: Theme.surface; border-radius: 16px;
                VerticalLayout {
                    padding: 24px; spacing: 12px;
                    HorizontalLayout {
                        Heading { text: "Настройки"; font-size: 22px; horizontal-stretch: 1; }
                        ActionButton { icon: @image-url("icons/close.svg"); accessible-name: "Закрыть настройки"; quiet: true; clicked => { root.settings-open = false; } }
                    }
                    ActionButton { text: "Открыть папку конфига"; icon: @image-url("icons/folder.svg"); clicked => { root.open-config(); } }
                    ActionButton { text: "Перечитать конфиг"; icon: @image-url("icons/refresh.svg"); enabled: root.can-reload; clicked => { root.refresh-tasks(); root.settings-open = false; } }
                    if !root.can-reload: Text { text: "Для перечитывания отключите все соединения."; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                    if root.selected >= 0: ActionButton { text: "Журнал подключения"; icon: @image-url("icons/log.svg"); clicked => { root.settings-open = false; root.select-log(""); root.show-log = true; } }
                    if root.can-hide-to-tray: ActionButton { text: "Свернуть в трей"; icon: @image-url("icons/tray.svg"); clicked => { root.settings-open = false; root.hide-to-tray(); } }
                    Rectangle { vertical-stretch: 1; }
                    ActionButton { text: "Выйти из MakePort"; quiet: true; clicked => { root.settings-open = false; root.request-quit(); } }
                }
            }
        }
        Rectangle {
            visible: root.show-log; background: #0c263877;
            FocusScope {
                enabled: root.confirm-kind == "" && !root.quitting;
            Rectangle {
                x: 24px; y: 24px; width: parent.width - 48px; height: parent.height - 48px;
                background: Theme.surface; border-radius: 16px;
                VerticalLayout {
                    padding: 24px; spacing: 16px;
                    HorizontalLayout {
                        Heading { text: root.log-name == "" ? "Журнал подключения" : "Журнал · " + root.log-name; font-size: 20px; horizontal-stretch: 1; }
                        if !root.follow-log: ActionButton { text: "К концу"; quiet: true; clicked => { root.follow-log = true; root.scroll-log(); } }
                        ActionButton { text: "Копировать всё"; icon: @image-url("icons/copy.svg"); enabled: root.log-text != ""; clicked => { root.copy-value(root.log-text); } }
                        ActionButton { icon: @image-url("icons/close.svg"); accessible-name: "Закрыть журнал"; quiet: true; clicked => { root.show-log = false; } }
                    }
                    Text { text: "Можно выделить и скопировать любую часть текста."; color: Theme.muted; font-size: 12px; }
                    log-editor := TextEdit {
                        text: root.log-text; read-only: true; font-family: root.mono-font; font-size: 13px; vertical-stretch: 1;
                        changed has-focus => { if self.has-focus { root.follow-log = false; } }
                        key-pressed(event) => {
                            if event.modifiers.control && !event.modifiers.alt {
                                if event.text == "с" || event.text == "С" || event.text == "C" { self.copy(); return accept; }
                                if event.text == "ф" || event.text == "Ф" || event.text == "A" { self.select-all(); return accept; }
                                if event.text == Key.Insert { self.copy(); return accept; }
                            }
                            return reject;
                        }
                    }
                }
            }
            }
        }
        Rectangle {
            visible: root.confirm-kind != ""; background: #0c263877;
            Rectangle {
                width: min(470px, parent.width - 48px); height: 248px;
                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                background: Theme.surface; border-radius: 16px;
                VerticalLayout {
                    padding: 28px; spacing: 16px;
                    Heading { text: root.confirm-kind == "reset" ? "Задача уже завершена?" : root.confirm-kind == "delete" ? "Удалить подключение?" : "Остановить задачи?"; font-size: 21px; }
                    Text { text: root.confirm-kind == "reset" ? "Проверьте процесс на сервере. Если задача завершена, подтвердите — её можно будет запустить снова." : root.confirm-kind == "delete" ? "Удалится только сохранённое подключение." : root.confirm-kind == "quit" ? "Задачи будут остановлены, подключения закроются." : "Остановим задачи и отключим порты этого сервера."; color: Theme.muted; wrap: word-wrap; }
                    Rectangle { vertical-stretch: 1; }
                    HorizontalLayout {
                        spacing: 8px;
                        Rectangle { horizontal-stretch: 1; }
                        confirm-cancel := ActionButton { text: "Отмена"; clicked => { root.confirm-kind = ""; } }
                        ActionButton { text: root.confirm-kind == "delete" ? "Удалить подключение" : root.confirm-kind == "reset" ? "Задача завершена" : "Остановить"; primary: true; clicked => {
                            if root.confirm-kind == "reset" { root.reset-target(root.confirm-target); }
                            else if root.confirm-kind == "delete" { root.delete-project(); }
                            else if root.confirm-kind == "quit" { root.quit(); }
                            else { root.toggle-connection(); }
                            root.confirm-kind = "";
                        } }
                    }
                }
            }
        }
        if root.quitting: Rectangle { background: Theme.canvas; Text { text: "Закрываем подключения…"; color: Theme.ink; horizontal-alignment: center; vertical-alignment: center; } }
        if root.copy-message != "": Rectangle {
            width: 130px; height: 36px; x: (parent.width - self.width) / 2; y: parent.height - 52px;
            border-radius: 8px; background: Theme.sidebar;
            Text { text: root.copy-message; color: white; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
        }
    }
}

export component AppTray inherits SystemTrayIcon {
    icon: @image-url("../assets/makeport.png");
    tooltip: "MakePort — " + root.status;
    in property <string> status: "MakePort работает";
    in property <bool> quitting;
    callback open-window();
    callback exit();
    clicked => { root.open-window(); }
    Menu {
        MenuItem { title: "Открыть MakePort"; activated => { root.open-window(); } }
        MenuItem { title: root.status; enabled: false; }
        MenuSeparator {}
        MenuItem { title: root.quitting ? "Завершение…" : "Завершить MakePort"; enabled: !root.quitting; activated => { root.exit(); } }
    }
}
