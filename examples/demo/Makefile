.PHONY: dev test fail

dev: ## Открыть демонстрационный сайт на порту 5173
	python3 -m http.server 5173 --bind 127.0.0.1

test: ## Выполнить короткую задачу
	@printf 'Начало проверки\n'
	@sleep 1
	@printf 'Проверка завершена\n'

fail: ## Проверить отображение ошибки
	@printf 'Намеренная ошибка\n' >&2
	@exit 7
